# Three connection strings, three privilege levels. This separation is the
# point: the app must never connect as a role that can bypass RLS.

# The application. Role visage_app: NOBYPASSRLS, not a table owner.
DATABASE_URL="postgresql://visage_app:app_dev_password@localhost:5432/visage?schema=public"

# Migrations only. Role visage_owner owns the tables.
MIGRATE_DATABASE_URL="postgresql://visage_owner:owner_dev_password@localhost:5432/visage?schema=public"

# Bootstrap only: creates the database and the two roles above. Superuser.
ADMIN_DATABASE_URL="postgresql://postgres@localhost:5432/postgres"

# Envelope encryption. In production this is a real KMS key id; the local
# provider below is for development only and refuses to run when NODE_ENV=production.
KMS_PROVIDER="local"
KMS_LOCAL_MASTER_KEY="dev-only-32-byte-key-replace-me!"

# Separate pepper for blind indexes, so a leaked field key does not also make
# the search index reversible.
BLIND_INDEX_PEPPER="dev-only-pepper-replace-me"

# Tests only. Superuser against the visage database, used to seed fixtures —
# every table is FORCE ROW LEVEL SECURITY, so even the owner role cannot insert
# a fixture without first assuming a tenant identity, which would make the
# fixtures depend on the mechanism under test.
TEST_ADMIN_DATABASE_URL="postgresql://postgres@localhost:5432/visage?schema=public"

# Object storage. The local driver writes to disk under STORAGE_LOCAL_ROOT;
# production uses an S3-compatible driver. Uploads land in a quarantine bucket
# and only reach the main bucket after scanning, sanitising, and encryption.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT=".storage"

# Malware scanning. "clamav" shells out to clamscan; anything else uses the
# structural heuristic scanner, which is NOT antivirus — see
# src/server/documents/scan.ts.
SCANNER="heuristic"
