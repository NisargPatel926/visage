{
  "name": "visage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:rls": "node scripts/apply-rls.mjs",
    "db:setup": "node scripts/setup-db.mjs",
    "db:seed": "node scripts/seed-dev.mjs",
    "test": "vitest run",
    "test:isolation": "vitest run tests/isolation",
    "form:dump": "node tools/dump-form-fields.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.1.0",
    "next": "^15.1.0",
    "otpauth": "^9.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.62.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
